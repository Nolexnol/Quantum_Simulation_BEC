# ---------------------------------------------------------------------------
# Data and outputs never enter version control.
#
# Raw .h5 shots are O(100 MB)-O(1 GB) per run; git history is append-only, so
# a single accidental commit is permanent. Everything under data/ and results/
# is either measured in the lab (back it up, do not commit it) or regenerated
# by a script (no reason to commit it).
# ---------------------------------------------------------------------------
# Ignore the CONTENTS, not the directories themselves: git will not descend
# into an excluded directory, so a `!` rule inside one can never take effect.
data/*
results/*
outputs/

# ...but keep the layout documented in git.
!data/README.md
!results/README.md

# Belt-and-braces: these extensions stay out even if they escape the dirs above.
*.h5
*.hdf5
*.npz
*.db
*.db-journal
*.tar.gz
*.gif

# --- Virtual environments ---
venv/
.venv/
env/
ENV/

# --- Python bytecode / caches ---
__pycache__/
*.py[cod]
*$py.class
*.so

# --- Packaging / build artifacts ---
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# --- Test / coverage / type-checker caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# --- Notebooks ---
.ipynb_checkpoints/

# --- Local configuration overrides ---
.env

# --- Editor / OS cruft ---
.vscode/
.idea/
.DS_Store
*.swp
